// Prisma schema for the ai-ecommerce backend (PostgreSQL)
//
// Migrated from Mongoose/MongoDB. Design notes:
// - Every model keeps the field name `_id` (mapped to the `id` column) so
//   that existing application code (controllers, tools, tests) that reads
//   `doc._id` keeps working without changes.
// - IDs use Postgres UUIDs instead of Mongo ObjectIds.
// - Embedded Mongoose sub-documents that never needed independent querying
//   (order shipping address snapshot, order status history) are kept as
//   JSON columns to preserve the original embedded-document semantics.
// - Embedded arrays that needed independent identity/updates (cart items,
//   order items) became proper relational tables with foreign keys.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  user
  admin

  @@map("user_role")
}

enum PaymentMethod {
  card
  cash_on_delivery

  @@map("payment_method")
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded

  @@map("payment_status")
}

enum OrderStatus {
  placed
  confirmed
  assigned
  packed
  out_for_delivery
  delivered
  cancelled

  @@map("order_status")
}

model User {
  _id       String   @id @default(uuid()) @map("id") @db.Uuid
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(user)
  phone     String?
  avatar    String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  addresses Address[]
  products  Product[]
  carts     Cart[]
  orders    Order[]
  reviews   Review[]

  @@map("users")
}

model Address {
  _id           String   @id @default(uuid()) @map("id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  user          User     @relation(fields: [userId], references: [_id], onDelete: Cascade)
  recipientName String   @map("recipient_name")
  phone         String
  street        String
  city          String
  state         String
  postalCode    String   @map("postal_code")
  country       String
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("addresses")
}

model Category {
  _id         String   @id @default(uuid()) @map("id") @db.Uuid
  name        String
  slug        String   @unique
  imageUrl    String?  @map("image_url")
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("categories")
}

model Product {
  _id             String   @id @default(uuid()) @map("id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  user            User     @relation(fields: [userId], references: [_id])
  categoryId      String   @map("category_id") @db.Uuid
  category        Category @relation(fields: [categoryId], references: [_id])
  name            String
  slug            String   @unique
  description     String?
  images          String[] @default([])
  originalPrice   Float    @map("original_price")
  salePrice       Float    @default(0) @map("sale_price")
  discountPercent Float    @default(0) @map("discount_percent")
  discountLabel   String?  @map("discount_label")
  unit            String   @default("pc")
  stockCount      Int      @default(0) @map("stock_count")
  ratingAverage   Float    @default(0) @map("rating_average")
  reviewCount     Int      @default(0) @map("review_count")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  cartItems  CartItem[]
  orderItems OrderItem[]
  reviews    Review[]

  @@index([categoryId])
  @@index([isActive])
  @@map("products")
}

model Cart {
  _id         String   @id @default(uuid()) @map("id") @db.Uuid
  userId      String?  @unique @map("user_id") @db.Uuid
  user        User?    @relation(fields: [userId], references: [_id], onDelete: Cascade)
  guestCartId String?  @unique @map("guest_cart_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  items CartItem[]

  @@map("carts")
}

model CartItem {
  _id       String  @id @default(uuid()) @map("id") @db.Uuid
  cartId    String  @map("cart_id") @db.Uuid
  cart      Cart    @relation(fields: [cartId], references: [_id], onDelete: Cascade)
  productId String  @map("product_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [_id], onDelete: Cascade)
  quantity  Int     @default(1)

  @@unique([cartId, productId])
  @@map("cart_items")
}

model Order {
  _id             String        @id @default(uuid()) @map("id") @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  user            User          @relation(fields: [userId], references: [_id])
  orderNo         String        @unique @map("order_no")
  // Snapshot of the address at order time (never queried on its own),
  // kept as JSON just like the embedded Mongoose sub-document was.
  shippingAddress Json          @map("shipping_address")
  paymentMethod   PaymentMethod @map("payment_method")
  paymentStatus   PaymentStatus @default(pending) @map("payment_status")
  status          OrderStatus   @default(placed)
  // Array of { status, note, date } — append-only log, kept as JSON like
  // the original embedded Mongoose array.
  statusHistory   Json          @default("[]") @map("status_history")
  subtotal        Float
  deliveryFee     Float         @default(0) @map("delivery_fee")
  tax             Float
  total           Float
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  items   OrderItem[]
  reviews Review[]

  @@index([userId])
  @@map("orders")
}

model OrderItem {
  _id             String   @id @default(uuid()) @map("id") @db.Uuid
  orderId         String   @map("order_id") @db.Uuid
  order           Order    @relation(fields: [orderId], references: [_id], onDelete: Cascade)
  productId       String   @map("product_id") @db.Uuid
  product         Product  @relation(fields: [productId], references: [_id])
  name            String
  image           String
  originalPrice   Float    @map("original_price")
  discountPercent Float    @default(0) @map("discount_percent")
  salePrice       Float    @map("sale_price")
  quantity        Int
  isReviewed      Boolean  @default(false) @map("is_reviewed")

  review Review?

  @@index([orderId])
  @@map("order_items")
}

model Review {
  _id         String    @id @default(uuid()) @map("id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  user        User      @relation(fields: [userId], references: [_id])
  orderId     String    @map("order_id") @db.Uuid
  order       Order     @relation(fields: [orderId], references: [_id])
  orderItemId String    @unique @map("order_item_id") @db.Uuid
  orderItem   OrderItem @relation(fields: [orderItemId], references: [_id])
  productId   String    @map("product_id") @db.Uuid
  product     Product   @relation(fields: [productId], references: [_id])
  rating      Int
  comment     String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([productId])
  @@index([userId])
  @@map("reviews")
}
